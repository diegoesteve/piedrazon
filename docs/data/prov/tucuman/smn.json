{"fuente": "Servicio Meteorológico Nacional, ssl.smn.gob.ar/CAP", "consultado": "2026-11-14 06:45", "alertas": [{"id": "2026_11_14_0826_cap_es", "tipo": "aviso a corto plazo", "evento": "Tormentas fuertes", "nivel": "naranja", "titulo": "AVISO NARANJA POR TORMENTAS FUERTES CON LLUVIAS INTENSAS", "desde": "2026-11-14T08:26:00-03:00", "hasta": "2026-11-14T10:26:00-03:00", "descripcion": "TORMENTAS FUERTES CON LLUVIAS INTENSAS", "instruccion": "Permanecé en construcciones cerradas como casas, escuelas o edificios públicos. Desconectá los electrodomésticos y cortá el suministro eléctrico si ingresa agua. Alejate de zonas inundables y no ingreses en calles anegadas. Mantenete alejado de artefactos eléctricos y evitá el uso de teléfonos con cable. Si estás al aire libre, buscá refugio inmediato en un edificio, casa o vehículo cerrado. Para minimizar el riesgo de ser alcanzado por un rayo, no permanezcas en playas, ríos, lagunas o piletas.", "zona": "SANTIAGO DEL ESTERO: BANDA - JIMENEZ - RIO HONDO. TUCUMAN: BURRUYACU - CHICLIGASTA - CRUZ ALTA - FAMAILLA - GRANEROS - LEALES - LULES - MONTEROS - S.  M.  DE TUCUMAN - SIMOCA - TAFI VIEJO - TRANCAS - YERBA BUENA.", "url": "https://ssl.smn.gob.ar/feeds/CAP/avisocortoplazo/2026_11_14_0826_cap_es.xml", "desde_local": "14/11 08:26", "hasta_local": "14/11 10:26", "localidades": 101}], "localidades": {"Acheral": ["2026_11_14_0826_cap_es"], "Alderetes": ["2026_11_14_0826_cap_es"], "Alto Verde (Tucumán)": ["2026_11_14_0826_cap_es"], "Arcadia": ["2026_11_14_0826_cap_es"], "Atahona (Tucumán)": ["2026_11_14_0826_cap_es"], "Banda del Río Salí": ["2026_11_14_0826_cap_es"], "Barrio Aeropuerto": ["2026_11_14_0826_cap_es"], "Barrio Araujo": ["2026_11_14_0826_cap_es"], "Barrio Mutual San Martín": ["2026_11_14_0826_cap_es"], "Barrio San Felipe": ["2026_11_14_0826_cap_es"], "Barrio San Jorge": ["2026_11_14_0826_cap_es"], "Bella Vista (Tucumán)": ["2026_11_14_0826_cap_es"], "Campo de Herrera": ["2026_11_14_0826_cap_es"], "Capitán Cáceres": ["2026